NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; needed only when running npm run seed. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Enable only after configuring Supabase Auth and allowed redirect URLs.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_AUTH_SIGNUP_ENABLED=false
NEXT_PUBLIC_AUTH_RECOVERY_ENABLED=false
